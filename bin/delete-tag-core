#!/usr/bin/env sh

. "$(dirname "$0")/_config.sh"

[ "$#" -eq 1 ] || { printf 'usage: delete-tag-core <tag>\n' >&2; exit 64; }
[ -n "${CACHE_CONTROL_TOKEN:-}" ] || { printf 'CACHE_CONTROL_TOKEN is required\n' >&2; exit 1; }
case "$1" in *[!a-zA-Z0-9:_./-]*) printf 'tag contains unsupported characters\n' >&2; exit 64;; esac

CORE_URL="$(cfg coreUrl)"
curl --fail-with-body --silent --show-error \
	--request POST \
	--header "Authorization: Bearer ${CACHE_CONTROL_TOKEN}" \
	--header 'Content-Type: application/json' \
	--header "x-vercel-protection-bypass: ${VERCEL_BYPASS_TOKEN:-}" \
	--data "{\"tag\":\"$1\"}" \
	"${CORE_URL}/api/delete"
