CORE_HOST=isr-platform-shield-core.playground-vercel.tools
SHIELD_HOST=shield.shield-platform.xyz
NEXT_PUBLIC_ROOT_DOMAIN=shield-platform.xyz

# Only needed for `pnpm deploy:shield`
VERCEL_TOKEN=your_vercel_token_here

# Deployment protection
VERCEL_BYPASS_TOKEN=xxx # this token should be created *for the core project*

# Authenticates the existing general control-plane invalidation route.
CACHE_CONTROL_TOKEN="replace-with-the-same-cache-control-secret-as-core"
