{
	"name": "@platform/shielded-isr-poc",
	"private": true,
	"scripts": {
		"setup": "pnpm install && ([ -f packages/config/validation.json ] || cp packages/config/validation.example.json packages/config/validation.json) && export PATH=$PATH:$(pwd)/bin",
		"seed": "pnpm --filter @platform/core seed",
		"start": "turbo run start",
		"build": "turbo run build --env-mode=loose",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "biome format --write",
		"deploy:poc:preview": "./bin/poc-deploy preview",
		"deploy:poc:production": "./bin/poc-deploy production",
		"deploy:poc:core": "./bin/poc-deploy core-only",
		"deploy:all": "./bin/poc-deploy preview",
		"touch:core": "turbo run touch --filter=@platform/core",
		"touch:shield": "turbo run touch --filter=@platform/shield",
		"validate": "turbo run validate",
		"validate:routing": "pnpm --filter validator validate:routing",
		"validate:cache": "pnpm --filter validator validate:cache",
		"tag:delete-core": "./bin/delete-tag-core",
		"tag:invalidate-shield": "./bin/invalidate-tag-shield",
		"purge-tag": "./bin/purge-tag"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"turbo": "^2.9.16",
		"typescript": "5.9.2",
		"vercel": "54.9.1"
	},
	"packageManager": "pnpm@10.12.4",
	"engines": {
		"node": ">=24"
	}
}
